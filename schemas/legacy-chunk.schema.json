{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kitterman-t/webshot-ai/schemas/legacy-chunk.schema.json",
  "$defs": {
    "TextChunk": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "heading_path",
        "block_ids",
        "text",
        "sha256"
      ],
      "title": "TextChunk",
      "type": "object"
    },
    "VisualChunk": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "visual",
          "title": "Type",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "heading_path",
        "asset_ids",
        "text",
        "sha256"
      ],
      "title": "VisualChunk",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/VisualChunk"
    },
    {
      "$ref": "#/$defs/TextChunk"
    }
  ],
  "description": "One line of `chunks.jsonl` on the web path.",
  "title": "WebChunk"
}
