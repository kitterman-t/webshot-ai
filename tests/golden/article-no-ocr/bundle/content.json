      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "The capture workflow should make the reliable choice the easy choice. Defaults should suit common reports, while explicit controls should remain available for unusual layouts and authenticated applications.",
      "text": "The capture workflow should make the reliable choice the easy choice. Defaults should suit common reports, while explicit controls should remain available for unusual layouts and authenticated applications."
    },
    {
      "self_ref": "#/texts/11",
      "parent": {
        "$ref": "#/texts/9"
