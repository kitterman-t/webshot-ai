      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "Use predictable paper geometry, repeat useful context in the header, and make navigation obvious with current and total page numbers. Avoid reintroducing hidden dialogs or stripping semantic structure.",
      "text": "Use predictable paper geometry, repeat useful context in the header, and make navigation obvious with current and total page numbers. Avoid reintroducing hidden dialogs or stripping semantic structure."
    },
