      "content_layer": "body",
      "label": "section_header",
      "prov": [],
      "orig": "Before capture",
      "text": "Before capture",
      "level": 2
    },
    {
      "self_ref": "#/texts/12",
      "parent": {
        "$ref": "#/texts/11"
      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "Wait for the page's meaningful readiness signal, load lazy content incrementally, and let web fonts and images settle. Preserve the original document tree so linked assets and inherited styles remain valid.",
      "text": "Wait for the page's meaningful readiness signal, load lazy content incrementally, and let web fonts and images settle. Preserve the original document tree so linked assets and inherited styles remain valid."
    },
    {
