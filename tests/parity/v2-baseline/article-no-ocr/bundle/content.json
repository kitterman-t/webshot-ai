    },
    {
      "id": "block-00002",
      "locator": "body > main > article > p",
      "text": "A representative long-form report used to verify typography, tables, page breaks, headers, and footers.",
      "type": "paragraph"
    },
    {
      "id": "block-00003",
      "locator": "body > main > article > section:nth-of-type(1) > h2",
      "text": "Executive summary",
      "type": "heading",
      "level": 2
    },
    {
      "id": "block-00004",
      "locator": "body > main > article > section:nth-of-type(1) > p",
      "text": "Professional web-to-PDF output should preserve the substance of a page while removing controls and interruptions that only make sense in a browser.",
      "type": "paragraph"
    },
